{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Attach",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/build/upper_leg_ecat_slave.elf",
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
      ]
    },

    {
      "name": "Debug",
      "cwd": "${workspaceRoot}",
      "executable": "./build/upper_leg_ecat_slave.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "jlink",
      "interface": "swd",
      "device": "XMC4800-F144x2048",
      "runToEntryPoint": "main",
      "armToolchainPath": "/opt/gcc-arm-none-eabi-10.3-2021.10/bin/"
    }
  ]
}